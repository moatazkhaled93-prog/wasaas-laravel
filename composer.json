{
  "name": "wasaas/wasaas-php",
  "description": "Official PHP/Laravel SDK for the Wasaas WhatsApp API",
  "keywords": ["whatsapp", "api", "sdk", "messaging", "wasaas", "laravel"],
  "homepage": "https://wasaas.org",
  "license": "MIT",
  "authors": [
    {
      "name": "Lexora",
      "email": "lexora87@gmail.com",
      "homepage": "https://lexora.fyi"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "laravel/framework": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Wasaas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wasaas\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Wasaas\\Laravel\\WasaasServiceProvider"
      ],
      "aliases": {
        "Wasaas": "Wasaas\\Laravel\\Facades\\Wasaas"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
